{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-log.schema.json",
  "title": "MGN review log entry",
  "description": "One line of a review.jsonl file next to a record (spec section 9).",
  "type": "object",
  "required": ["record", "reviewer", "date", "scope", "tiers", "verdict"],
  "properties": {
    "record": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewer": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["agent", "person", "tool"]},
        "name": {"type": "string", "minLength": 1},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "scope": {
      "oneOf": [
        {"const": "all"},
        {
          "type": "object",
          "required": ["transitions"],
          "properties": {"transitions": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "items": false, "minItems": 2}},
          "additionalProperties": false
        }
      ]
    },
    "tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": [1, 2]}},
    "verdict": {"enum": ["vetted", "defect", "inconclusive", "replayed"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["note"],
        "properties": {
          "transition": {"type": "integer", "minimum": 0},
          "path": {"type": "string"},
          "note": {"type": "string", "minLength": 1},
          "rules": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{3}(\\.[0-9]+[a-z]?)?$"}}
        },
        "additionalProperties": false
      }
    },
    "receipt": {"type": "string"},
    "supersedes": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
